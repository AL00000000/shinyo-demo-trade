{
  "name": "shinyo-sim",
  "version": "1.3.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "server": "tsx server/index.ts",
    "sync": "tsx server/sync.ts",
    "export": "expo export --platform all",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:android": "npx eas-cli build --platform android --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "^5.2.0",
    "decimal.js": "^10.6.0",
    "expo": "~57.0.27",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
