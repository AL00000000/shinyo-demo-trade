# 公開アプリに埋め込めるのは本人用APIのURLだけ。秘密鍵は絶対にEXPO_PUBLICにしない。
EXPO_PUBLIC_API_URL=https://prices.example.jp
# 本人用の無料取得: public-personal / 一般配信契約: licensed
PRICE_PROVIDER=public-personal
# 以下は取得サーバー専用。契約済み配信元を正規化したJSONエンドポイント。
LICENSED_FEED_URL=https://licensed-provider.example.jp/japan/eod
LICENSED_FEED_TOKEN=
DATA_LICENSE_CONFIRMED=false
DATA_DIR=./data
PORT=8787
HOST=127.0.0.1
# 本人用の終値API。32文字以上のランダムキーを生成し、別デバイスの設定画面へ入力。
API_ACCESS_TOKEN=
# 東証・名証・福証・札証の全上場銘柄取得を契約先アダプターで保証
REQUIRED_MARKETS=TSE,NSE,FSE,SSE
